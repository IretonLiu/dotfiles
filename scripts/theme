#!/usr/bin/env python3
"""Render and apply the shared desktop theme.

The palette registry is version controlled. Rendered application fragments live
in ~/.local/state/dotfiles-theme so applying a theme never dirties dotfiles.
"""

from __future__ import annotations

import argparse
import fcntl
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import time
from typing import Any

ROOT = Path(__file__).resolve().parent.parent
PALETTES_PATH = ROOT / "themes" / "palettes.json"
STATE_DIR = Path(os.environ.get("DOTFILES_THEME_STATE_DIR", Path.home() / ".local" / "state" / "dotfiles-theme"))
GTK_DIRS = (Path.home() / ".config" / "gtk-3.0", Path.home() / ".config" / "gtk-4.0")
PI_AGENT_DIR = Path(os.environ.get("PI_CODING_AGENT_DIR", Path.home() / ".pi" / "agent"))


def atomic_write(path: Path, content: str, mode: int = 0o644) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    with temporary.open("w", encoding="utf-8") as handle:
        handle.write(content)
        handle.flush()
        os.fsync(handle.fileno())
    os.chmod(temporary, mode)
    os.replace(temporary, path)


def write_change_marker(path: Path, content: str) -> None:
    """Trigger FileView watchers after the associated file was atomically replaced."""
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w", encoding="utf-8") as handle:
        handle.write(content)
        handle.flush()
        os.fsync(handle.fileno())


def load_profiles() -> dict[str, dict[str, Any]]:
    with PALETTES_PATH.open(encoding="utf-8") as handle:
        data = json.load(handle)
    profiles = data.get("profiles")
    if not isinstance(profiles, dict) or not profiles:
        raise ValueError(f"No profiles found in {PALETTES_PATH}")
    return profiles


def hex_without_hash(value: str) -> str:
    return value.removeprefix("#")


def render_hyprland(palette: dict[str, Any]) -> str:
    return f"""# Generated by ~/dotfiles/scripts/theme. Do not edit.
# Palette: {palette['profile']}

general {{
    col.active_border = rgba({hex_without_hash(palette['accent'])}ff)
    col.inactive_border = rgba({hex_without_hash(palette['border'])}ff)
}}

decoration {{
    shadow {{
        color = rgba({hex_without_hash(palette['shadow'])}cc)
    }}
}}
"""


def render_alacritty(palette: dict[str, Any]) -> str:
    terminal = palette["terminal"]

    def section(name: str, values: dict[str, str]) -> str:
        lines = [f"[colors.{name}]"]
        lines.extend(f'{key} = "{value}"' for key, value in values.items())
        return "\n".join(lines)

    return "\n\n".join((
        "# Generated by ~/dotfiles/scripts/theme. Do not edit.",
        section("primary", {
            "background": terminal["background"],
            "foreground": terminal["foreground"],
            "dim_foreground": palette["muted"],
            "bright_foreground": palette["highlight"],
        }),
        section("cursor", {
            "cursor": terminal["cursor"],
            "text": terminal["background"],
        }),
        section("selection", {
            "text": palette["highlight"],
            "background": palette["accent"],
        }),
        section("normal", terminal["normal"]),
        section("bright", terminal["bright"]),
        "",
    ))


def render_gtk(palette: dict[str, Any]) -> str:
    # Symbolic names are honoured by traditional GTK themes and safely ignored
    # by widgets that use their own Libadwaita colour machinery.
    colors = {
        "theme_bg_color": palette["surface"],
        "theme_fg_color": palette["highlight"],
        "theme_base_color": palette["surface_darker"],
        "theme_text_color": palette["highlight"],
        "theme_selected_bg_color": palette["accent"],
        "theme_selected_fg_color": palette["surface_darker"],
        "theme_unfocused_bg_color": palette["surface_lighter"],
        "theme_unfocused_fg_color": palette["muted"],
        "borders": palette["border"],
        "warning_color": palette["warning"],
        "error_color": palette["danger"],
        "success_color": palette["success"],
    }
    lines = ["/* Generated by ~/dotfiles/scripts/theme. Do not edit. */"]
    lines.extend(f"@define-color {name} {value};" for name, value in colors.items())
    return "\n".join(lines) + "\n"


def render_dunst(palette: dict[str, Any]) -> str:
    """Render the checked-in dunstrc while replacing just its semantic colors."""
    source = (ROOT / "dunst" / "dunstrc").read_text(encoding="utf-8")
    values = {
        ("global", "frame_color"): palette["border"],
        ("urgency_low", "background"): palette["surface_lighter"],
        ("urgency_low", "foreground"): palette["muted"],
        ("urgency_normal", "background"): palette["surface"],
        ("urgency_normal", "foreground"): palette["highlight"],
        ("urgency_critical", "background"): palette["surface_darker"],
        ("urgency_critical", "foreground"): palette["highlight"],
        ("urgency_critical", "frame_color"): palette["danger"],
    }
    section = ""
    rendered: list[str] = [f"# Generated palette: {palette['profile']}"]
    section_pattern = re.compile(r"^\s*\[([^]]+)]")
    setting_pattern = re.compile(r"^(\s*)([A-Za-z_][A-Za-z0-9_-]*)(\s*=\s*)(.*)$")

    for line in source.splitlines():
        section_match = section_pattern.match(line)
        if section_match:
            section = section_match.group(1)
        setting_match = setting_pattern.match(line)
        if setting_match and (section, setting_match.group(2)) in values:
            indent, key, equals, _ = setting_match.groups()
            line = f'{indent}{key}{equals}"{values[(section, key)]}"'
        rendered.append(line)

    return "\n".join(rendered) + "\n"


def active_pi_theme_name() -> str:
    """Use Pi's selected custom theme, falling back to a managed theme name."""
    settings_path = PI_AGENT_DIR / "settings.json"
    try:
        settings = json.loads(settings_path.read_text(encoding="utf-8"))
    except (FileNotFoundError, json.JSONDecodeError):
        settings = {}

    selected = settings.get("theme")
    if isinstance(selected, str) and selected not in {"system", "dark", "light"} and "/" not in selected:
        return selected

    # A built-in or automatic selection cannot be rendered. Select a dedicated
    # user theme; Pi may need `/reload` once to pick up this initial setting.
    settings["theme"] = "shared-desktop"
    atomic_write(settings_path, json.dumps(settings, indent=2) + "\n")
    return "shared-desktop"


def render_pi(palette: dict[str, Any], theme_name: str) -> str:
    terminal = palette["terminal"]
    theme = {
        "$schema": "https://pi.dev/schemas/theme.schema.json",
        "name": theme_name,
        "appearance": palette["mode"],
        "vars": {
            "void": palette["surface_darker"],
            "surface": palette["surface"],
            "surfaceLift": palette["surface_lighter"],
            "surfaceAccent": palette["surface_accent"],
            "successSurface": palette["success_surface"],
            "dangerSurface": palette["danger_surface"],
            "ghost": palette["highlight"],
            "lavender": palette["accent"],
            "lavenderDim": palette["border"],
            "lime": palette["success"],
            "limeDim": terminal["bright"]["green"],
            "redHot": palette["danger"],
            "slate": palette["muted"],
            "slateDim": palette["border"],
            "green": palette["success"],
            "red": palette["danger"],
            "amber": palette["warning"],
        },
        "colors": {
            "accent": "lavender", "border": "lavenderDim", "borderAccent": "lavender", "borderMuted": "slateDim",
            "success": "lime", "error": "redHot", "warning": "amber", "muted": "slate", "dim": "slateDim", "text": "ghost", "thinkingText": "slate",
            "selectedBg": "surfaceAccent", "userMessageBg": "surfaceAccent", "userMessageText": "ghost",
            "customMessageBg": "surfaceLift", "customMessageText": "ghost", "customMessageLabel": "lime",
            "toolPendingBg": "surfaceLift", "toolSuccessBg": "successSurface", "toolErrorBg": "dangerSurface", "toolTitle": "lavender", "toolOutput": "ghost",
            "mdHeading": "lavender", "mdLink": "lime", "mdLinkUrl": "slate", "mdCode": "lime", "mdCodeBlock": "ghost", "mdCodeBlockBorder": "lavenderDim", "mdQuote": "slate", "mdQuoteBorder": "lavenderDim", "mdHr": "slateDim", "mdListBullet": "lime",
            "toolDiffAdded": "lime", "toolDiffRemoved": "redHot", "toolDiffContext": "slate",
            "syntaxComment": "slate", "syntaxKeyword": "lavender", "syntaxFunction": "lime", "syntaxVariable": "ghost", "syntaxString": "limeDim", "syntaxNumber": "redHot", "syntaxType": "limeDim", "syntaxOperator": "lavender", "syntaxPunctuation": "slate",
            "thinkingOff": "slateDim", "thinkingMinimal": "lavenderDim", "thinkingLow": "lavender", "thinkingMedium": "lime", "thinkingHigh": "redHot", "thinkingXhigh": "redHot", "bashMode": "amber",
        },
        "export": {"pageBg": "void", "cardBg": "surface", "infoBg": "surfaceAccent"},
    }
    return json.dumps(theme, indent=2) + "\n"


def palette_for(profile: str, profiles: dict[str, dict[str, Any]]) -> dict[str, Any]:
    if profile not in profiles:
        choices = ", ".join(sorted(profiles))
        raise ValueError(f"Unknown theme '{profile}'. Available themes: {choices}")
    palette = dict(profiles[profile])
    palette["profile"] = profile
    required = {
        "mode", "gtk_theme", "gtk_accent", "surface", "surface_lighter",
        "surface_darker", "surface_accent", "success_surface", "danger_surface",
        "accent", "muted", "highlight", "border", "track", "shadow", "danger",
        "success", "warning", "terminal",
    }
    missing = required.difference(palette)
    if missing:
        raise ValueError(f"Theme '{profile}' is missing: {', '.join(sorted(missing))}")
    return palette


def render_all(palette: dict[str, Any]) -> dict[str, Path]:
    paths = {
        "quickshell": STATE_DIR / "quickshell.json",
        "hyprland": STATE_DIR / "hyprland-colors.conf",
        "alacritty": STATE_DIR / "alacritty.toml",
        "gtk": STATE_DIR / "gtk.css",
        "dunst": STATE_DIR / "dunstrc",
    }
    pi_theme_name = active_pi_theme_name()
    paths["pi"] = PI_AGENT_DIR / "themes" / f"{pi_theme_name}.json"
    atomic_write(paths["quickshell"], json.dumps(palette, indent=2) + "\n")
    atomic_write(paths["hyprland"], render_hyprland(palette))
    atomic_write(paths["alacritty"], render_alacritty(palette))
    atomic_write(paths["gtk"], render_gtk(palette))
    atomic_write(paths["dunst"], render_dunst(palette))
    atomic_write(paths["pi"], render_pi(palette, pi_theme_name))
    # FileView follows the original file inode. Keep completed palettes atomic,
    # then update this in-place marker so running Quickshell instances reload it.
    write_change_marker(Path.home() / ".cache" / "quickshell-theme-state", palette["mode"] + "\n")
    return paths


def install_gtk_loaders(gtk_css: Path) -> list[str]:
    messages: list[str] = []
    loader = (
        "/* Managed by ~/dotfiles/scripts/theme. */\n"
        f'@import url("file://{gtk_css}");\n'
    )
    marker = "/* Managed by ~/dotfiles/scripts/theme. */"
    for directory in GTK_DIRS:
        path = directory / "gtk.css"
        if path.exists() and not path.read_text(encoding="utf-8").startswith(marker):
            messages.append(f"left existing custom GTK CSS untouched: {path}")
            continue
        atomic_write(path, loader)
    return messages


def command_exists(command: str) -> bool:
    return shutil.which(command) is not None


def run(command: list[str], *, quiet: bool = True) -> bool:
    try:
        result = subprocess.run(
            command,
            check=False,
            stdout=subprocess.DEVNULL if quiet else None,
            stderr=subprocess.DEVNULL if quiet else None,
        )
        return result.returncode == 0
    except FileNotFoundError:
        return False


def apply_gtk_settings(palette: dict[str, Any]) -> list[str]:
    if not command_exists("gsettings"):
        return ["gsettings unavailable; skipped GTK system preference"]
    scheme = "prefer-light" if palette["mode"] == "light" else "prefer-dark"
    commands = (
        ["gsettings", "set", "org.gnome.desktop.interface", "color-scheme", scheme],
        ["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", palette["gtk_theme"]],
        ["gsettings", "set", "org.gnome.desktop.interface", "accent-color", palette["gtk_accent"]],
    )
    failures = [" ".join(command) for command in commands if not run(list(command))]
    return [f"could not apply GTK preference: {command}" for command in failures]


def reload_hyprland() -> str:
    if command_exists("hyprctl") and run(["hyprctl", "reload"]):
        return "Hyprland reloaded"
    return "Hyprland reload skipped (not available in this session)"


def reload_alacritty(palette: dict[str, Any]) -> str:
    if not command_exists("pgrep") or not run(["pgrep", "-x", "alacritty"]):
        return "Alacritty not running; generated colors will load on its next launch"

    terminal = palette["terminal"]
    settings = [
        f'colors.primary.background="{terminal["background"]}"',
        f'colors.primary.foreground="{terminal["foreground"]}"',
        f'colors.cursor.cursor="{terminal["cursor"]}"',
        f'colors.cursor.text="{terminal["background"]}"',
        f'colors.selection.text="{palette["highlight"]}"',
        f'colors.selection.background="{palette["accent"]}"',
    ]
    settings.extend(f'colors.normal.{name}="{value}"' for name, value in terminal["normal"].items())
    settings.extend(f'colors.bright.{name}="{value}"' for name, value in terminal["bright"].items())
    if command_exists("alacritty") and run(["alacritty", "msg", "config", "-w", "-1", *settings]):
        return "Alacritty updated in every running window"
    return "Alacritty will use the generated colors after its config watcher reloads"


def dunst_was_paused() -> bool:
    if not command_exists("dunstctl"):
        return False
    result = subprocess.run(["dunstctl", "is-paused"], check=False, capture_output=True, text=True)
    return result.returncode == 0 and result.stdout.strip().lower() == "true"


def restart_dunst(config_path: Path) -> str:
    if not command_exists("dunst"):
        return "Dunst unavailable; generated configuration is ready for its next launch"
    paused = dunst_was_paused()
    running = command_exists("pgrep") and run(["pgrep", "-x", "dunst"])
    if running:
        run(["dunstctl", "close-all"])
        run(["pkill", "-x", "dunst"])
        time.sleep(0.15)
    subprocess.Popen(
        ["dunst", "-conf", str(config_path)],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    if paused:
        time.sleep(0.15)
        run(["dunstctl", "set-paused", "true"])
    return "Dunst restarted with the generated palette"


def current_profile(profiles: dict[str, dict[str, Any]]) -> str:
    current_path = STATE_DIR / "quickshell.json"
    try:
        current = json.loads(current_path.read_text(encoding="utf-8"))
        profile = current.get("profile")
        if profile in profiles:
            return profile
    except (FileNotFoundError, json.JSONDecodeError):
        pass
    return "dark"


def apply(profile: str) -> int:
    profiles = load_profiles()
    palette = palette_for(profile, profiles)
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    lock_path = STATE_DIR / ".apply.lock"
    with lock_path.open("w", encoding="utf-8") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        paths = render_all(palette)
        notes = install_gtk_loaders(paths["gtk"])
        notes.extend(apply_gtk_settings(palette))
        notes.append(reload_hyprland())
        notes.append(reload_alacritty(palette))
        notes.append(restart_dunst(paths["dunst"]))
        notes.append(f"Pi theme rendered to {paths['pi']}")
    print(f"Applied shared '{profile}' theme.")
    for note in notes:
        print(f"- {note}")
    print("- Quickshell and the active Pi user theme update from watched palette files.")
    print("- Reopen any GTK window that does not redraw its CSS automatically.")
    return 0


def start_dunst() -> int:
    profiles = load_profiles()
    profile = current_profile(profiles)
    palette = palette_for(profile, profiles)
    dunst_path = STATE_DIR / "dunstrc"
    if not dunst_path.exists():
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        with (STATE_DIR / ".apply.lock").open("w", encoding="utf-8") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            render_all(palette)
    os.execvp("dunst", ["dunst", "-conf", str(dunst_path)])
    return 1


def main() -> int:
    parser = argparse.ArgumentParser(description="Apply the shared desktop theme")
    subcommands = parser.add_subparsers(dest="command", required=True)
    apply_parser = subcommands.add_parser("apply", help="render and apply a named theme")
    apply_parser.add_argument("profile", help="theme profile name")
    subcommands.add_parser("list", help="list available profiles")
    subcommands.add_parser("current", help="print the selected profile")
    subcommands.add_parser("dunst", help="start Dunst with the generated palette")
    arguments = parser.parse_args()

    try:
        profiles = load_profiles()
        if arguments.command == "apply":
            return apply(arguments.profile)
        if arguments.command == "list":
            print("\n".join(sorted(profiles)))
            return 0
        if arguments.command == "current":
            print(current_profile(profiles))
            return 0
        if arguments.command == "dunst":
            return start_dunst()
    except (OSError, ValueError, json.JSONDecodeError) as error:
        print(f"theme: {error}", file=sys.stderr)
        return 1
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
