* {
  border: none;
  border-radius: 20px;
  font-family: "CodeNewRoman Nerd Font Propo";
  /*font-family: "JetBrainsMono Nerd Font", monospace;*/
  font-size: 17px;
  font-weight: 600;
  min-height: 0;
  box-shadow: none;
  outline: none;
}

@define-color primary #89b4fa;
@define-color secondary #f38ba8;
@define-color pale #d2e2fd;
window#waybar {
  all: unset;
}

.modules-left {
  margin: 5 5 0 5px;
  padding: 1 5px;
  border: 2px solid rgba(255, 255, 255, 0.2);
  background: rgba(0, 0, 0, 0);
}

.modules-center {
  margin: 5 5 0 5px;
  padding: 1 5px;
  border: 2px solid rgba(255, 255, 255, 0.2);
  background: rgba(255, 255, 255, 0.2);
}
.modules-right {
  margin: 5 5 0 5px;
  padding: 1 10 1 5px;
  border: 2px solid rgba(255, 255, 255, 0.2);
  background: rgba(0, 0, 0, 0);
}

@keyframes flow {
  0% {
    background-position: 0% 50%;
  }
  100% {
    background-position: -400% 50%;
  }
}

#workspaces button {
  padding: 2 8px;
  margin: 0 2px;
  border-radius: 20px;
  color: #cdd6f4; /* text color */
  background: transparent; /* background color */
  transition:
    background 0.3s,
    padding 0.3s;
}

#workspaces button.active {
  background: linear-gradient(90deg, @primary, @pale, @primary);
  background-size: 400% 400%; /* makes it large so it can flow */
  animation: flow 10s linear infinite;
  padding: 2 20px;
  color: #1e1e2e;
}

#workspaces button.urgent {
  background: @secondary;
  color: #1e1e2e;
}

#workspaces button:hover {
  background: #c2ddff; /* highlight active workspace */
  text-shadow: none;
  color: #1e1e2e;
  padding: 2 20px;
}

#window {
  padding: 0 10px;
  color: #ffffff;
  background: linear-gradient(90deg, @secondary, @primary, @secondary);
  background-size: 400% 400%; /* makes it large so it can flow */
  /* animation of gradient */
  animation: flow 120s linear infinite;
}

#clock,
#battery,
#cpu,
#memory,
#disk,
#temperature,
#backlight,
#network,
#pulseaudio,
#wireplumber,
#custom-media,
#tray,
#mode,
#idle_inhibitor,
#scratchpad,
#bluetooth,
#window,
#clock {
  background-color: transparent;
}

#clock {
  padding: 0 10px;
  transition: all 0.3s;
}

#clock:hover {
  padding: 0 10px;
  background: @primary;
  color: #1a1b26;
}

#battery {
  background: transparent;
  color: #ffffff;
  padding: 0 10px;
  transition:
    background 0.3s,
    padding 0.3s,
    color 0.3s;
}

#battery.charging,
#battery.plugged {
  color: #26a65b;
}
#battery:hover {
  background: @primary;
  padding: 0 20px;
  color: #1a1b26;
}

@keyframes blink {
  to {
    background-color: #ffffff;
    color: #000000;
  }
}

#battery.critical:not(.charging) {
  background-color: @secondary;
  color: #ffffff;
  animation-name: blink;
  animation-duration: 0.5s;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
  animation-direction: alternate;
}

#network {
  padding: 2 8px;
  background: transparent;
  border-radius: 20px;
  transition:
    background 0.3s,
    padding 0.3s,
    color 0.3s;
}
#network:hover {
  background: @primary;
  color: #1a1b26;
  padding: 0 20px;
}

#network.disconnected {
  background-color: @secondary;
}

#wireplumber {
  padding: 0 10px;
  border-radius: 20px;
  color: #ffffff;
  transition:
    background 0.3s,
    padding 0.3s;
}

#wireplumber:hover {
  background-color: inherit;
  background: @primary;
  color: #1a1b26;
  padding: 0 20px;
}

#wireplumber.muted {
}

#custom-media {
  background-color: #66cc99;
  color: #2a5c45;
  min-width: 100px;
}

#custom-media.custom-spotify {
  background-color: #66cc99;
}

#custom-media.custom-vlc {
  background-color: #ffa000;
}

#temperature {
  background-color: transparent;
  color: #ffffff;
}

#temperature.critical {
  background-color: @secondary;
  border-radius: 10px;
  padding-right: 15px;
}

#mpd {
  background-color: #66cc99;
  color: #2a5c45;
}

#mpd.disconnected {
  background-color: @secondary;
}

#mpd.stopped {
  background-color: #90b1b1;
}

#mpd.paused {
  background-color: #51a37a;
}

#bluetooth {
  padding: 0 10px;
  border-radius: 20px;
  color: #ffffff;
  transition:
    background 0.3s,
    padding 0.3s;
}
#bluetooth:hover {
  background: @primary;
  color: #1a1b26;
  padding: 0 20px;
}

#custom-powermenu {
  background: transparent;
  padding: 0 10px;
  border-radius: 20px;
  transition:
    background 0.3s,
    padding 0.3s;
}
#custom-powermenu:hover {
  background: @primary;
  color: #1a1b26;
  padding: 0 20 0 20px;
}
